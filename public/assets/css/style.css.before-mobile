:root {
  color-scheme: dark;
  --bg: #0c0c13;
  --card: #171724;
  --text: #f6f4ff;
  --muted: #a8a4bc;
  --accent: #a855f7;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, sans-serif;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  border-bottom: 1px solid #292638;
}

.logo {
  color: #d5aaff;
  text-decoration: none;
  font-size: 22px;
  font-weight: 800;
}

.version {
  color: var(--muted);
  font-size: 12px;
}

main {
  max-width: 1100px;
  margin: auto;
  padding: 22px;
}

.hero {
  padding: 60px 24px;
  margin-bottom: 35px;
  border-radius: 22px;
  background: linear-gradient(135deg, #5521a8, #17172c 75%);
}

.eyebrow {
  color: #e5c6ff;
  font-size: 12px;
  letter-spacing: 2px;
}

h1 {
  font-size: clamp(30px, 6vw, 54px);
}

.hero p {
  line-height: 1.7;
}

h2 {
  margin-bottom: 20px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.card {
  display: block;
  padding: 22px;
  border: 1px solid #302b43;
  border-radius: 18px;
  background: var(--card);
  color: var(--text);
  text-decoration: none;
}

.card span {
  color: var(--accent);
  font-size: 28px;
}

.card h3 {
  margin: 14px 0 8px;
}

.card p {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.5;
}

.card:hover {
  border-color: var(--accent);
}

footer {
  text-align: center;
  padding: 35px;
  color: var(--muted);
}

@media (max-width: 480px) {
  .hero {
    padding: 40px 22px;
  }

  .card {
    padding: 17px;
  }

  .card h3 {
    font-size: 16px;
  }
}

/* VELTRIA v1.2 - Mobile UI */

html {
  scroll-behavior: smooth;
}

body {
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

main {
  width: min(100%, 1100px);
  margin: auto;
  padding: 20px 16px 70px;
}

.hero {
  border-radius: 24px;
  padding: 38px 24px;
  box-shadow: 0 14px 40px rgba(0,0,0,.18);
}

.hero h1 {
  font-size: clamp(32px, 7vw, 58px);
  line-height: 1.12;
  letter-spacing: -1px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 12px;
}

.card {
  min-width: 0;
  min-height: 165px;
  padding: 18px;
  border-radius: 18px;
  transition: transform .2s, border-color .2s;
}

.card h3 {
  font-size: 17px;
  line-height: 1.35;
  margin: 10px 0;
}

.card p {
  font-size: 13px;
  line-height: 1.55;
}

.card:active {
  transform: scale(.98);
}

.card:focus-visible {
  outline: 2px solid #b78cff;
  outline-offset: 3px;
}

@media (min-width: 760px) {
  .grid {
    grid-template-columns: repeat(3,minmax(0,1fr));
  }
}

@media (max-width: 380px) {
  .card {
    padding: 14px;
  }

  .card h3 {
    font-size: 15px;
  }
}
